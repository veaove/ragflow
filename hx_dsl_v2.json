    "Agent:Legal": {
      "obj": {
        "component_name": "Agent",
        "params": {
          "llm_id": "qwen-flash@tongyi@Tongyi-Qianwen",
          "sys_prompt": "你是华夏基金的**法务合规专家**，负责解答法律法规、合规要求、合同条款、投资者适当性、反洗钱、信息披露义务、纠纷处理相关问题。\n要求：\n1. 先看【参考资料】，资料有明确规定就严格按资料口径表述，不要自行发挥；\n2. 涉及「能不能做」「是否违规」的判断，必须说明依据；\n3. 资料没有的内容，直接说「这一点需要合规部门确认」，不要编造条文或编号；\n4. 不做投资建议，不承诺收益，不评价具体产品好坏。\n用简体中文，条理清晰，300 字以内。",
          "prompts": [
            {
              "role": "user",
              "content": "【参考资料】\n{Retrieval:Legal@formalized_content}\n\n【用户问题】\n{sys.query}"
            }
          ],
          "cite": true,
          "temperature": 0.1,
          "temperatureEnabled": true,
          "top_p": 0.3,
          "topPEnabled": true,
          "presence_penalty": 0.4,
          "presencePenaltyEnabled": true,
          "frequency_penalty": 0.7,
          "frequencyPenaltyEnabled": false,
          "max_tokens": 2048,
          "maxTokensEnabled": false,
          "max_rounds": 1,
          "max_retries": 3,
          "delay_after_error": 1,
          "message_history_window_size": 6,
          "description": "",
          "exception_method": "",
          "exception_goto": [],
          "exception_default_value": "",
          "tools": [],
          "mcp": [],
          "outputs": {
            "content": {
              "type": "string",
              "value": ""
            }
          },
          "visual_files_var": "",
          "showStructuredOutput": false
        }
      },
      "upstream": [
        "Retrieval:Legal"
      ],
      "downstream": [
        "VariableAggregator:Pick"
      ]
    },
