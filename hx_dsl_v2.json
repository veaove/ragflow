    "begin": {
      "obj": {
        "component_name": "Begin",
        "params": {
          "mode": "conversational",
          "enablePrologue": true
        }
      },
      "upstream": [],
      "downstream": [
        "Agent:Router"
      ]
    },
    "Agent:Router": {
      "obj": {
        "component_name": "Agent",
        "params": {
          "llm_id": "qwen-flash@tongyi@Tongyi-Qianwen",
          "sys_prompt": "你是华夏基金客服系统的意图分类器。\n阅读用户问题，把它归入下面四类中的一类，并**只输出类目名**（2-4 个汉字），不要输出解释、标点、引号或任何其他内容。\n\n分类标准：\n1. 法务 —— 法律法规、合规要求、合同条款、投资者适当性、反洗钱、信息披露义务、违规认定、投诉与纠纷处理；\n2. 企业信息 —— 公司成立时间、股东背景、组织架构、投研体系、企业文化、所获荣誉、社会责任、销售网点、联系方式；\n3. 业务政策 —— 基金申购赎回规则、费率费用、份额确认、分红方式、开放期安排、账户与交易限制；\n4. 其他 —— 寒暄闲聊、与基金业务无关、或索要投资建议/买卖时点/收益预测。\n\n只输出类目名。",
          "prompts": [
            {
              "role": "user",
              "content": "{sys.query}"
            }
          ],
          "cite": false,
          "temperature": 0.1,
          "temperatureEnabled": true,
          "top_p": 0.3,
          "topPEnabled": true,
          "presence_penalty": 0.4,
          "presencePenaltyEnabled": true,
          "frequency_penalty": 0.7,
          "frequencyPenaltyEnabled": false,
          "max_tokens": 32,
          "maxTokensEnabled": false,
          "max_rounds": 1,
          "max_retries": 3,
          "delay_after_error": 1,
          "message_history_window_size": 6,
          "description": "",
          "exception_method": "",
          "exception_goto": [],
          "exception_default_value": "",
          "tools": [],
          "mcp": [],
          "outputs": {
            "content": {
              "type": "string",
              "value": ""
            }
          },
          "visual_files_var": "",
          "showStructuredOutput": false
        }
      },
      "upstream": [
        "begin"
      ],
      "downstream": [
        "Switch:Route"
      ]
    },
    "Switch:Route": {
      "obj": {
        "component_name": "Switch",
        "params": {
          "conditions": [
            {
              "items": [
                {
                  "cpn_id": "Agent:Router@content",
                  "operator": "contains",
                  "value": "法务"
                }
              ],
              "logical_operator": "and",
              "to": [
                "Retrieval:Legal"
              ]
            },
            {
              "items": [
                {
                  "cpn_id": "Agent:Router@content",
                  "operator": "contains",
                  "value": "企业信息"
                }
              ],
              "logical_operator": "and",
              "to": [
                "Retrieval:Corp"
              ]
            },
            {
              "items": [
                {
                  "cpn_id": "Agent:Router@content",
                  "operator": "contains",
                  "value": "业务政策"
                }
              ],
              "logical_operator": "and",
              "to": [
                "Retrieval:Policy"
              ]
            }
          ],
          "end_cpn_ids": [
            "Agent:General"
          ]
        }
      },
      "upstream": [
        "Agent:Router"
      ],
      "downstream": [
        "Retrieval:Legal",
        "Retrieval:Corp",
        "Retrieval:Policy",
        "Agent:General"
