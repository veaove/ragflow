{
  "components": {
    "begin": {
      "obj": {
        "component_name": "Begin",
        "params": {
          "mode": "conversational",
          "enablePrologue": true
        }
      },
      "upstream": [],
      "downstream": [
        "Agent:ParseSections"
      ]
    },
    "Agent:ParseSections": {
      "obj": {
        "component_name": "Agent",
        "params": {
          "llm_id": "qwen-flash@tongyi@Tongyi-Qianwen",
          "sys_prompt": "你是标书结构整理助手。用户会给出一份章节清单，格式可能不统一（有的写「项目背景：检索+模型排版」，有的只写标题，有的带序号）。\n请把它整理成规范格式，**每行一个章节**，形如：\n1. 项目背景：检索知识库中关于项目与客户背景的资料，写出项目缘起与目标\n\n整理规则：\n1. 严格保持用户给出的章节顺序，不要增删章节；\n2. 冒号前是章节名，冒号后是该章的写作要求；\n3. 用户只给了章节名没给要求时，按标书惯例补一句要求（如「概述本章要点」），不要编造具体业务内容；\n4. 项目名出现在用户输入里时，把它写进每一章的要求里，便于后续检索定位；\n5. 章节之间不要空行，除清单外不要输出任何解释、前言或结尾语。\n\n只输出章节清单本身。",
          "prompts": [
            {
              "role": "user",
              "content": "{sys.query}"
            }
          ],
          "cite": false,
          "temperature": 0.1,
          "temperatureEnabled": true,
          "top_p": 0.3,
          "topPEnabled": true,
          "presence_penalty": 0.4,
          "presencePenaltyEnabled": true,
          "frequency_penalty": 0.7,
          "frequencyPenaltyEnabled": false,
          "max_tokens": 1024,
          "maxTokensEnabled": false,
          "max_rounds": 1,
          "max_retries": 3,
          "delay_after_error": 1,
          "message_history_window_size": 4,
          "description": "把用户输入的章节清单规范成一行一章",
          "exception_method": "",
          "exception_goto": [],
          "exception_default_value": "",
          "tools": [],
          "mcp": [],
          "outputs": {
            "content": {
              "type": "string",
              "value": ""
            }
          },
          "visual_files_var": "",
          "showStructuredOutput": false
        }
      },
      "upstream": [
        "begin"
      ],
      "downstream": [
        "StringTransform:Split"
      ]
    },
    "StringTransform:Split": {
      "obj": {
        "component_name": "StringTransform",
        "params": {
          "method": "split",
          "delimiters": [
            "\n"
          ],
          "split_ref": "Agent:ParseSections@content",
          "script": "",
          "outputs": {
            "result": {
              "type": "Array<string>"
            }
          }
        }
      },
      "upstream": [
        "Agent:ParseSections"
      ],
      "downstream": [
        "Parallel:PerSection"
      ]
    },
    "Parallel:PerSection": {
      "obj": {
        "component_name": "Parallel",
        "params": {
          "items_ref": "StringTransform:Split@result",
          "max_concurrency": 1,
          "outputs": {
            "sections": {
              "ref": "Agent:WriteSection@content",
              "type": "Array<string>"
            }
          }
        }
      },
      "upstream": [
        "StringTransform:Split"
      ],
      "downstream": [
        "StringTransform:Join"
      ]
    },
    "Retrieval:Section": {
      "obj": {
        "component_name": "Retrieval",
        "params": {
          "kb_ids": [
            "6995fa4b2ad24d5f9270fcfe18d12d1d"
          ],
          "query": "{item}",
          "similarity_threshold": 0.2,
          "keywords_similarity_weight": 0.7,
          "top_k": 1024,
          "top_n": 6,
          "rerank_id": "",
          "retrieval_from": "dataset",
          "use_kg": false,
          "toc_enhance": false,
          "cross_languages": [],
          "meta_data_filter": {},
          "empty_response": "（本章暂无匹配资料）",
          "outputs": {
            "formalized_content": {
              "type": "string",
              "value": ""
            },
            "json": {
              "type": "Array<Object>",
              "value": []
            }
          }
        }
      },
      "upstream": [],
      "downstream": [
        "Agent:WriteSection"
      ]
    },
    "Agent:WriteSection": {
      "obj": {
        "component_name": "Agent",
        "params": {
          "llm_id": "qwen-flash@tongyi@Tongyi-Qianwen",
          "sys_prompt": "你是标书撰写专家，正在写标书中的**一章**。\n\n写作要求：\n1. 只写本章内容，不要重复输出其它章节；\n2. 【参考资料】里有依据的，严格按资料表述，不要发挥；\n3. 资料没有覆盖的部分，写通用表述并在句末标注（待补充），**不要编造数字、案例名称、客户名**；\n4. 涉及金额、比例、日期时，资料里没有就留空并标注（待补充）；\n5. 输出格式：先一行 `## 章节标题`，然后正文段落；\n6. 正文 300-600 字，分 2-4 段，不要用列表堆砌。\n\n用简体中文，语言平实、像正式标书，不要营销腔。",
          "prompts": [
            {
              "role": "user",
              "content": "【本章要求】\n{item}\n\n【参考资料】\n{Retrieval:Section@formalized_content}\n\n请按上面的要求写这一章。"
            }
          ],
          "cite": true,
          "temperature": 0.2,
          "temperatureEnabled": true,
          "top_p": 0.3,
          "topPEnabled": true,
          "presence_penalty": 0.4,
          "presencePenaltyEnabled": true,
          "frequency_penalty": 0.7,
          "frequencyPenaltyEnabled": false,
          "max_tokens": 2048,
          "maxTokensEnabled": false,
          "max_rounds": 1,
          "max_retries": 3,
          "delay_after_error": 1,
          "message_history_window_size": 4,
          "description": "按章节要求与检索素材撰写本章",
          "exception_method": "",
          "exception_goto": [],
          "exception_default_value": "",
          "tools": [],
          "mcp": [],
          "outputs": {
            "content": {
              "type": "string",
              "value": ""
            }
          },
          "visual_files_var": "",
          "showStructuredOutput": false
        }
      },
      "upstream": [
        "Retrieval:Section"
      ],
      "downstream": []
    },
    "StringTransform:Join": {
      "obj": {
        "component_name": "StringTransform",
        "params": {
          "method": "merge",
          "delimiters": [
            "\n\n"
          ],
          "script": "{Parallel:PerSection@sections}",
          "split_ref": "",
          "outputs": {
            "result": {
              "type": "string"
            }
          }
        }
      },
      "upstream": [
        "Parallel:PerSection"
      ],
      "downstream": [
        "Message:Output"
      ]
    },
    "Message:Output": {
      "obj": {
        "component_name": "Message",
        "params": {
          "content": [
            "{StringTransform:Join@result}"
          ]
        }
      },
      "upstream": [
        "StringTransform:Join"
      ],
      "downstream": []
    }
  },
