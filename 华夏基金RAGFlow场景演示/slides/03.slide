<Slide padding={60} style={{ fontFamily: 'Microsoft YaHei' }}>
  <Box style={{ height: '100%', flexDirection: 'column' }}>
    <Box style={{ marginBottom: 18 }}>
      <Text style={{ fontSize: 14, color: '#B08D57', fontWeight: 'bold', letterSpacing: 2 }}>价值逻辑 / WHY RAGFLOW</Text>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E3A5F', marginTop: 6 }}>RAGFlow，天生适配金融知识场景</Text>
      <Box style={{ height: 3, background: '#B08D57', width: '100%', marginTop: 12, borderRadius: 2 }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
      {[
        { icon: 'shield', t: '私有化部署，数据不出域', d: '满足金融行业合规与数据安全要求，知识资产留在内网' },
        { icon: 'file-text', t: '深度文档解析，长合同/公告精准读懂', d: '复杂版式、表格、多栏文档均可结构化抽取' },
        { icon: 'search', t: '回答可溯源，关键结论标注原文出处', d: '每一条答案都能回溯到原始材料，可审计可核查' },
        { icon: 'copy', t: '多格式接入，表格/文档/录音统一管', d: '一套知识底座，承载基金业务的多类知识资产' },
      ].map((c, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F1F5F9', borderRadius: 12, padding: 18 }}>
          <Box style={{ width: 56, height: 56, borderRadius: 14, background: '#EAF0F7', justifyContent: 'center', alignItems: 'center' }}>
            <FAIcon name={c.icon} style={{ fill: '#1E3A5F', width: 28, height: 28 }} />
          </Box>
          <Box>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A5F' }}>{c.t}</Text>
            <Text style={{ fontSize: 16, color: '#64748B', marginTop: 4, lineHeight: 1.4 }}>{c.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ marginTop: 18, paddingTop: 14, borderTop: '1px solid #E2E8F0', flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 13, color: '#94A3B8' }}>RAGFlow · 基金行业知识大模型落地演示</Text>
      <Text style={{ fontSize: 13, color: '#94A3B8' }}>03 / 12</Text>
    </Box>
  </Box>
</Slide>
